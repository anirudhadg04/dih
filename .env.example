# Vercel production requires the same SMTP values as local dev:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=<gmail-address>
# SMTP_PASS=<gmail-app-password>
# MAIL_FROM="Anvation 2026 <gmail-address>"
#
# Approval email delivery reads the stored team.members[].email records and
# sends exactly to those registered participant addresses.
# Local-only CSV backup sync. Do not configure local filesystem paths on Vercel.
GITHUB_BACKUP_SYNC=true
GITHUB_BACKUP_BRANCH=main
# Required on Vercel: durable canonical JSON registration ledger.
# Use a fine-grained token limited to Contents: Read and write for this repo.
GITHUB_BACKUP_REPOSITORY=anirudhadg04/dih
GITHUB_BACKUP_TOKEN=
