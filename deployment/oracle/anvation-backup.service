[Unit]
Description=Create a local ANVATION data snapshot
After=anvation.service

[Service]
Type=oneshot
User=anvation
Group=anvation
EnvironmentFile=-/etc/anvation/anvation.env
ExecStart=/opt/anvation/deployment/oracle/local-backup.sh
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/anvation
