# /etc/anvation/anvation.env — keep this file readable only by root/anvation.
NODE_ENV=production
PORT=3001
INTERNAL_PORT=3002
# One public worker plus the authority process is a sensible starting point on
# Oracle's 2-OCPU Always Free VM. Leave empty to use one Node process instead.
CLUSTER_WORKERS=1

# Keep mutable records outside /opt/anvation so code deployments do not touch
# registrations or backups.
DATA_DIR=/var/lib/anvation
BACKUP_DIR=/var/lib/anvation/backups

# Add SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS, and MAIL_FROM below only if
# registration emails should be delivered. Do not commit real credentials.
