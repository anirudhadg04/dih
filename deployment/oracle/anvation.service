[Unit]
Description=ANVATION registration website
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=anvation
Group=anvation
WorkingDirectory=/opt/anvation
EnvironmentFile=-/etc/anvation/anvation.env
ExecStart=/usr/bin/node /opt/anvation/dist/server.cjs
Restart=always
RestartSec=5
TimeoutStopSec=20
UMask=0077
LimitNOFILE=65536

# The service can read application code, but its registration data and backups
# are isolated in /var/lib/anvation.
StateDirectory=anvation
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/anvation

[Install]
WantedBy=multi-user.target
